# Configuración de entorno de desarrollo
VITE_API_URL=http://localhost:3000
VITE_BASE_URL=/
VITE_UPLOADS_BASE_URL=

# true = usar copias livianas de imagenes (public/opt y /uploads/opt); false = originales
VITE_USE_OPTIMIZED_IMAGES=false

# Configuración de autenticación (si es necesaria)
